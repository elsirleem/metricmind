ANTHROPIC_API_KEY=your_key_here

# Git platform tokens — read-only scope is sufficient
# Credentials only — project IDs and base URLs are declared per profile in the UI
GITLAB_TOKEN=your_gitlab_token_here   # GitLab personal access token with read_api scope
GITHUB_TOKEN=your_github_token_here   # GitHub personal access token with repo (read) scope

# Jira — API token from id.atlassian.net
# Credentials only — project keys and base URLs are declared per profile in the UI
JIRA_EMAIL=your_email@example.com
JIRA_TOKEN=your_token_here

# Database
DATABASE_URL=sqlite:///./metricmind.db

# LLM provider: 'anthropic' | 'gemini' | 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
